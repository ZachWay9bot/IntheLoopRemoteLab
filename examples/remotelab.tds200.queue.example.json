      }
    },
    {
      "module": "remotelab.adapters.tds200",
      "class": "TektronixTDS200Adapter",
      "enabled": false,
      "args": {
        "name": "tds210",
        "port": "COM_PORT_TDS210",
        "baudrate": 9600,
        "flow_control": "none"
      }
    }
  ]
}
